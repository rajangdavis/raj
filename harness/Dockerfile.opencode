FROM node:22-slim

ENV OC_UID=501
ENV OC_GID=20

RUN apt-get update && apt-get install -y --no-install-recommends \
      git ca-certificates ripgrep jq \
 && rm -rf /var/lib/apt/lists/*

RUN npm install -g opencode-ai@latest

RUN (getent group ${OC_GID} || groupadd -g ${OC_GID} ocgrp) \
 && useradd -m -u ${OC_UID} -g ${OC_GID} -s /bin/bash oc

# every dir opencode/bun will touch must exist and be oc-owned
RUN mkdir -p \
      /home/oc/.local/share/opencode \
      /home/oc/.local/state \
      /home/oc/.cache \
      /home/oc/.config/opencode/skills \
      /work \
      /tmp/opencode

# Paths are relative to the REPO (the docker build context): build with
# `docker build -f harness/Dockerfile.opencode .` from the repo root.
COPY bin/raj-linux /usr/local/bin/raj
COPY skills/raj-editor/SKILL.md /home/oc/.config/opencode/skills/raj-editor/SKILL.md
# The recursive workflow (RECURSIVE-RAJ.md) and the review contract
# (REVIEW-AGENT.md) are dev-process docs under docs/dev, which is not part of
# the product and is absent from a fresh clone. Copy the docs index as an
# always-present anchor plus the dev tree as an optional glob (a trailing-*
# source that matches nothing is skipped), then install the two skills only
# when their sources exist. The directory may land either merged or under dev/,
# so probe both.
COPY docs/README.md docs/dev* /tmp/rajdocs/
RUN set -e; \
    install_skill() { \
      if [ -f "$1" ]; then \
        mkdir -p "$(dirname "$2")"; \
        cp "$1" "$2"; \
      fi; \
    }; \
    install_skill /tmp/rajdocs/dev/REVIEW-AGENT.md /home/oc/.config/opencode/skills/raj-review-agent/SKILL.md; \
    install_skill /tmp/rajdocs/REVIEW-AGENT.md /home/oc/.config/opencode/skills/raj-review-agent/SKILL.md; \
    install_skill /tmp/rajdocs/dev/RECURSIVE-RAJ.md /home/oc/.config/opencode/skills/raj-recursive/SKILL.md; \
    install_skill /tmp/rajdocs/RECURSIVE-RAJ.md /home/oc/.config/opencode/skills/raj-recursive/SKILL.md; \
    rm -rf /tmp/rajdocs
COPY plugins/raj-gate.ts /home/oc/.config/opencode/plugin/raj-gate.ts
COPY plugins/raj-mail.ts /home/oc/.config/opencode/plugin/raj-mail.ts
COPY harness/opencode/opencode.json /home/oc/.config/opencode/opencode.json
COPY harness/opencode/agents/ /home/oc/.config/opencode/agents/
# call-runs (the opencode.db metrics script) is dev-process tooling and is
# git-ignored, so a fresh clone does not have it: copy it with a source that
# always matches (Dockerfile.opencode itself) and install it only if present.
COPY harness/Dockerfile.opencode scripts/call-runs.mj[s] /tmp/rajscripts/
RUN if [ -f /tmp/rajscripts/call-runs.mjs ]; then \
      mkdir -p /usr/local/lib/raj \
      && cp /tmp/rajscripts/call-runs.mjs /usr/local/lib/raj/call-runs.mjs \
      && printf '%s\n' '#!/bin/sh' 'exec node /usr/local/lib/raj/call-runs.mjs "$@"' \
           > /usr/local/bin/call-runs \
      && chmod 0755 /usr/local/bin/call-runs; \
    fi; \
    rm -rf /tmp/rajscripts

RUN chmod 0755 /tmp/opencode

RUN chmod 0755 /usr/local/bin/raj \
  && chown -R ${OC_UID}:${OC_GID} /home/oc /work

USER oc
ENV HOME=/home/oc
ENV XDG_STATE_HOME=/home/oc/.local/state
ENV XDG_CACHE_HOME=/home/oc/.cache
ENV RAJ_CONTROL_ADDR=tcp://host.docker.internal:7391
WORKDIR /work
# No --continue here: `oc` passes it for the primary session, and a worker
# (`ocw`) starts its own session instead of colliding with that one.
ENTRYPOINT ["opencode", "--auto"]
